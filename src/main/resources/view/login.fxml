<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.LoginController"
      prefWidth="1100" prefHeight="720" alignment="CENTER">

    <!-- LEFT: brand panel với gradient xanh -->
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="16"
          style="-fx-background-color: linear-gradient(to bottom right, #1877F2, #0095F6);"
          prefWidth="500">
        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <Label text="BidNow" style="-fx-font-size: 56; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label wrapText="true" text="Sàn đấu giá trực tuyến realtime."
               style="-fx-font-size: 22; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Label wrapText="true"
               text="Tìm kiếm món đồ độc đáo, đấu giá minh bạch, kết nối với cộng đồng người chơi đam mê."
               style="-fx-font-size: 15; -fx-text-fill: rgba(255,255,255,0.92);"/>
    </VBox>

    <!-- RIGHT: form login -->
    <VBox alignment="CENTER" prefWidth="600" spacing="0">
        <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

        <VBox styleClass="card,card-padded" maxWidth="400" spacing="14">
            <Label text="Đăng nhập" styleClass="h1"/>
            <Label text="Chào mừng bạn quay lại với BidNow" styleClass="muted"/>

            <Region prefHeight="8"/>

            <Label text="Tên đăng nhập hoặc email" styleClass="caption"/>
            <TextField fx:id="usernameField" promptText="vd: nam_dev"/>

            <Label text="Mật khẩu" styleClass="caption"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"/>

            <Label fx:id="errorLabel" styleClass="error-text" visible="false" managed="false"/>

            <Button text="Đăng nhập" styleClass="btn-primary" maxWidth="Infinity"
                    onAction="#handleLogin"/>

            <Hyperlink text="Quên mật khẩu?" style="-fx-text-fill: -fx-primary;"
                       onAction="#handleForgot"/>

            <Separator/>

            <Button text="Tạo tài khoản mới" styleClass="btn-accent" maxWidth="Infinity"
                    onAction="#handleGoRegister"/>
        </VBox>

        <Region prefHeight="20"/>
        <Label text="© 2026 BidNow • LTNC Team" styleClass="caption"/>
    </VBox>
</HBox>
